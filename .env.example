PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/vaquinha.sqlite

# Produto / meta (valores em centavos)
TITULO="Jogo de dardos + proteção de parede"
DESCRICAO="Alvo de sisal com dardos e proteção de parede em EVA para a nossa confraternização."
IMAGENS=/images/dardos.jpg,/images/protecao.jpeg
META_CENTAVOS=49999
MAX_CONTRIBUICAO_CENTAVOS=50000
RATE_LIMIT_POR_MINUTO=10

# Pix do organizador (obrigatório). Formatos da chave:
#   CPF/CNPJ: só números (12345678900)
#   Telefone: +55DDDNUMERO (+5511999998888)
#   E-mail: minúsculas
#   Aleatória: o UUID como aparece no app
PIX_CHAVE=
# Nome do recebedor (até 25 caracteres) e cidade (até 15). Acentos são removidos.
PIX_NOME="Seu Nome"
PIX_CIDADE="Sao Paulo"

# Ligue apenas quando servir atrás de um túnel (cloudflared/ngrok):
# faz o rate limit contar por IP real, lido de X-Forwarded-For.
TRUST_PROXY=false
